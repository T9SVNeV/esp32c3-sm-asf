CONFIG_IDF_TARGET_ESP32C3=y

# Flash：4MB（含 LittleFS 分区）
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 日志：串口输出运行日志
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_BACKEND_SERIAL=y

# 控制台：USB-Serial-JTAG（SuperMini 板载 USB 直连，便于调试日志与 panic 输出）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 分区表：自定义（含 LittleFS 分区）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LittleFS 组件配置（joltwallet/littlefs）
CONFIG_LITTLEFS_CACHE_SIZE=128

# WiFi 省电：挂机场景保持连接，禁用 modem sleep 的 PS 避免断连
CONFIG_PM_ENABLE=n

# 主频
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# HTTP 服务器（Web 仪表盘）
CONFIG_ESP_HTTP_SERVER=y

# TLS 证书 bundle（Steam CM 443 连接需要）
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
